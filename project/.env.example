# Copy this file to .env and fill in your own values. Never commit .env itself.

# Required: your Groq API key (https://console.groq.com/keys — free tier available)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides (defaults shown)
GROQ_BASE_URL=https://api.groq.com/openai/v1
TRIAGE_MODEL=openai/gpt-oss-120b
TRIAGE_TEMPERATURE=0
TRIAGE_MAX_TOKENS=1024
EMBEDDING_MODEL=all-MiniLM-L6-v2
KB_TOP_K=3
KB_MIN_SCORE=0.35